# ---------------------------------------------
#  Campus2Career Backend - Example Environment File
#  Rename this file to ".env" and fill in values
# ---------------------------------------------

# ---------------------------------------------
# Database Configuration
# ---------------------------------------------
# Replace <username>, <password>, and <dbname> with actual credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ---------------------------------------------
# Authentication
# ---------------------------------------------
# Use a long random string (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_here
# Optional. Keep the default for short-lived access tokens with refresh support.
JWT_EXPIRES_IN=7d

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
PORT=5000
# Public backend origin used when generating uploaded-file URLs.
BACKEND_URL=http://localhost:5000

# ---------------------------------------------
# CORS - comma-separated list of allowed frontend origins
# ---------------------------------------------
# Development:
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# Production (uncomment and adjust):
# FRONTEND_URLS=https://campus2career.vercel.app,https://campus2career-prod.vercel.app

# ---------------------------------------------
# AI / NVIDIA Nemotron API (primary for Career Guidance chat)
# ---------------------------------------------
# Base URL: https://integrate.api.nvidia.com/v1
# Model: nvidia/nemotron-3-ultra-550b-a55b
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional override:
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ---------------------------------------------
# AI / Gemini API (fallback when NVIDIA is unavailable)
# ---------------------------------------------
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional override:
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------
# Email — Resend (transactional email provider)
# ---------------------------------------------
# Get your API key at https://resend.com
# RESEND_API_KEY must NEVER be exposed to the frontend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Campus2Career
# Optional: webhook signing secret from Resend dashboard
# RESEND_WEBHOOK_SECRET=

# ---------------------------------------------
# Google OAuth (Sign-In)
# ---------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://localhost:5173, https://campus2career.zayacodehub.in
# Authorized redirect URIs: not required for Google Identity Services button flow
GOOGLE_CLIENT_ID=
