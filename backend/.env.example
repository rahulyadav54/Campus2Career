# ---------------------------------------------
#  Campus2Career Backend - Example Environment File
#  Rename this file to ".env" and fill in values
# ---------------------------------------------

# ---------------------------------------------
# Database Configuration
# ---------------------------------------------
# Replace <username>, <password>, and <dbname> with actual credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ---------------------------------------------
# Authentication
# ---------------------------------------------
# Use a long random string (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_here
# Optional. Keep the default for short-lived access tokens with refresh support.
JWT_EXPIRES_IN=7d

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
PORT=5000
# Public backend origin used when generating uploaded-file URLs.
BACKEND_URL=http://localhost:5000

# ---------------------------------------------
# CORS - comma-separated list of allowed frontend origins
# ---------------------------------------------
# Development:
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# Production (uncomment and adjust):
# FRONTEND_URLS=https://campus2career.vercel.app,https://campus2career-prod.vercel.app

# ---------------------------------------------
# AI / Gemini API
# ---------------------------------------------
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
